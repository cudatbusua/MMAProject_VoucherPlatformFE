NODE_ENV=development
PORT=4100
MONGODB_URI=mongodb://127.0.0.1:27018/voucher_platform?replicaSet=rs0&directConnection=true
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
OTP_SECRET=replace-with-another-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://localhost:8082
# local: OTP appears ONLY in the development server console. brevo: real email.
MAIL_PROVIDER=local
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Voucher Platform
# Demo payment only; never sends money. Cannot be enabled in production.
PAYMENT_MODE=demo
DEMO_PAYMENT_ENABLED=true
SEED_PASSWORD=
